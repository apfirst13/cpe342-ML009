rule
# Virtual Environment
venv/
.venv/
.env/
env/

# Python cache & Jupyter checkpoints
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# Kaggle Dataset: Ignore heavy files (CSV train/test, images, zips)
data/**/*.csv
!data/sample_submission.csv
data/**/*.zip
data/**/*.tar.gz
data/**/*.png
data/**/*.jpg
data/**/*.jpeg
data/cpe342-kaggle-main/
CPE342-Hackathon/

# Model checkpoints & artifacts
*.pkl
*.pt
*.pth
*.cbm
*.joblib
*.npy
catboost_info/
**/catboost_info/

# Task 4 & Task 3 local helper scripts, blueprints & plots (keep locally, exclude from git)
task4/TASK4_BLUEPRINT.md
task4/phase*.py
task4/build_notebook.py
task4/eda_plots/
task3/step*.py
task3/train_task3_upgraded.py
task3/build_task3_notebook.py
task3/sub_task3.csv

# Submissions
submissions/*.csv
!submissions/.gitkeep
final_submission*.csv

# OS files
.DS_Store
Thumbs.db
